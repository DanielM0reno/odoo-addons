<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_academia_alumno_list" model="ir.ui.view">
        <field name="name">academia.alumno.list</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <list string="Alumnos">
                <field name="name"/>
                <field name="apellidos"/>
                <field name="fecha_nacimiento"/>
                <field name="email"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_academia_alumno_form" model="ir.ui.view">
        <field name="name">academia.alumno.form</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <form string="Alumno">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del alumno"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos personales">
                            <field name="apellidos"/>
                            <field name="fecha_nacimiento"/>
                        </group>
                        <group string="Contacto y estado">
                            <field name="email" widget="email"/>
                            <field name="activo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_academia_alumno_search" model="ir.ui.view">
        <field name="name">academia.alumno.search</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <search string="Buscar alumnos">
                <field name="name"/>
                <field name="apellidos"/>
                <field name="email"/>
                <filter name="activos" string="Activos" domain="[('activo', '=', True)]"/>
                <filter name="inactivos" string="Inactivos" domain="[('activo', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Acción y menús -->
    <record id="action_academia_alumno" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">academia.alumno</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_academia_alumno_search"/>
    </record>

    <menuitem id="menu_academia_root" name="Academia" sequence="10"/>
    <menuitem id="menu_academia_alumnos"
              name="Alumnos"
              parent="menu_academia_root"
              action="action_academia_alumno"
              sequence="10"/>
</odoo>
